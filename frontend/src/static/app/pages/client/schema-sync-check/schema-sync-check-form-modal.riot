<schema-sync-check-form-modal>
  <!-- documentMap.dfprop の schemaSyncCheckMap を編集するための Modal -->
  <su-modal show="{ show() }" modal="{ modal() }" class="large">
    <form class="ui form">
      <div class="required field">
        <label>URL</label>
        <input
          type="url"
          placeholder="jdbc:mysql://localhost:3306/examplesyncdb"
          value="{ state.syncSchemaSetting.url }"
          onchange="{ (e) => console.log('url changed:', e.target.value) }">
      </div>
      <div class="field">
        <label>Schema</label>
        <input
          type="text"
          placeholder="EXAMPLESYNCDB"
          value="{ state.syncSchemaSetting.schema }"
          onchange="{ (e) => console.log('schema changed:', e.target.value) }">
      </div>
      <div class="required field">
        <label>User</label>
        <input
          type="text"
          placeholder="examplesyncdb"
          value="{ state.syncSchemaSetting.user }"
          onchange="{ (e) => console.log('user changed:', e.target.value) }">
      </div>
      <div class="field">
        <label>Password</label>
        <input
          type="text"
          placeholder=""
          value="{ state.syncSchemaSetting.password }"
          onchange="{ (e) => console.log('password changed:', e.target.value) }">
      </div>
      <div class="field">
        <div class="ui checkbox">
          <input
            type="checkbox"
            checked="{ state.syncSchemaSetting.isSuppressCraftDiff }"
            onchange="{ (e) => console.log('isSuppressCraftDiff changed:', e.target.checked) }">
          <label>Suppress Craft Diff</label>
        </div>
      </div>
    </form>
  </su-modal>
  <script>
    import schemaSyncCheckFormModal from './schema-sync-check-form-modal.ts'
    export default schemaSyncCheckFormModal
  </script>
</schema-sync-check-form-modal>
