<schema-policy-check-statement-form-expected>
  <!-- ClientのSchemaPolicyCheckのStatement追加フォームのExpectedの部分 (migrated to Riot v7 at 2026/04/26)
   機能:
    o expected部分の情報を入力することができる
    o and/orでつなげて複数のexpectedを設定することができる。

   作りの特徴:
    o input部分は別tagに切り出されている。(schema-policy-check-statement-form-expected-field)
   -->
  <div class="grouped fields required">
    <label>Expected</label>
    <!-- document / sample -->
    <p>
      <schema-policy-check-statement-form-docuement-link form-type="{ props.formType }"></schema-policy-check-statement-form-docuement-link>
      /
      <a onclick="{ toggleSample }">sample</a>
    </p>

    <!-- sampleのtoggle -->
    <div if="{ state.showSample }" class="ui info message">
      <div class="ui two column grid">
        <div class="column">
          <h5>Format</h5>
          <div class="ui segment">
            <span class="variable">SUBJECT</span> is (not) <span class="variable">VALUE</span>
          </div>
          <p>or</p>
          <div class="ui segment">
            <span class="variable">THEME</span>
          </div>
        </div>
        <div class="column">
          <h5>Sample</h5>
          <div class="ui inverted segment">
            <div class="comment">// FK constraint name must be FK_[tableName]_...</div>
            <div><span class="variable">fkName</span> is <span class="variable">prefix:FK_$$table$$</span></div>
            <div class="comment">// column DB type must be VARCHAR (only for column)</div>
            <div><span class="variable">dbType</span> is <span class="variable">VARCHAR</span></div>
            <div class="ui divider"></div>
            <div><span class="variable">hasPK</span> <span class="comment">// must has PK constraint</span></div>
            <div><span class="variable">notNull</span> <span class="comment">// must has NotNull constraint</span></div>
          </div>
          <a href="http://dbflute.seasar.org/ja/manual/reference/dfprop/schemapolicy/index.html#example" target="_blank">more sample</a>
        </div>
      </div>
    </div>

    <!-- 各Expected行 -->
    <schema-policy-check-statement-form-expected-field
      each="{ field in props.fields }"
      key="{ field.id }"
      id="{ field.id }"
      subject-verb="{ field.subjectVerb }"
      complement="{ field.complement }"
      is-deletable="{ isDeletable }"
      on-change="{ props.onFieldChange }"
      on-delete="{ onDeleteField }"
    ></schema-policy-check-statement-form-expected-field>

    <!-- 行追加と and/or ラジオボタン -->
    <div class="ui grid">
      <div class="four wide right floated column">
        <i class="plus link icon" style="float: right" onclick="{ onclickAddField }"></i>
        <div if="{ needsCondition() }" class="inline fields" style="float: right">
          <div class="field">
            <div class="ui radio checkbox">
              <input type="radio" name="expected-mode" ref="isAnd" onchange="{ onChangeCondition }">
              <label>and</label>
            </div>
          </div>
          <div class="field">
            <div class="ui radio checkbox">
              <input type="radio" name="expected-mode" ref="isOr" onchange="{ onChangeCondition }">
              <label>or</label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .variable {
      font-style: italic;
      font-weight: bold;
    }
    .comment {
      color: darkgray;
    }
  </style>

  <script>
    import schemaPolicyCheckStatementFormExpected from './schema-policy-check-statement-form-expected.ts'
    export default schemaPolicyCheckStatementFormExpected
  </script>
</schema-policy-check-statement-form-expected>
